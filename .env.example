# Pi-hole Environment Configuration

# Timezone
TZ=UTC

# Web Interface Password
FTLCONF_webserver_api_password=changeme

# Pi-hole Settings
DNSMASQ_LISTENING=all
DNSSEC=true
REV_SERVER=false

# Network Configuration
PIHOLE_SUBNET=172.20.0.0/24
PRIMARY_IP=172.20.0.10

# Port Configuration
PRIMARY_DNS_PORT=53
PRIMARY_WEB_PORT=8080
PRIMARY_HTTPS_PORT=8443

# Cloudflare Tunnel (optional - see CLOUDFLARE_TUNNEL_SETUP.md)
# TUNNEL_TOKEN=your_tunnel_token_here
