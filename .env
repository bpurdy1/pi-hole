# Pi-hole Environment Configuration

# Timezone
TZ=UTC

# Web Interface Password
# Set to your desired password, or leave empty for no password

FTLCONF_webserver_api_password=admin  #Default password is 'admin'


# Upstream DNS Servers (semicolon separated)
# Cloudflare: 1.1.1.1;1.0.0.1
# Google: 8.8.8.8;8.8.4.4
# Quad9: 9.9.9.9;149.112.112.112
# PIHOLE_DNS_=1.1.1.1;1.0.0.1

# Pi-hole Settings
DNSMASQ_LISTENING=all
DNSSEC=true
REV_SERVER=false

# Network Configuration
PIHOLE_SUBNET=172.20.0.0/24
PRIMARY_IP=172.20.0.10
SECONDARY_IP=172.20.0.11

# Port Configuration
PRIMARY_DNS_PORT=53
SECONDARY_DNS_PORT=54
PRIMARY_WEB_PORT=8080
SECONDARY_WEB_PORT=8081
PRIMARY_HTTPS_PORT=8443
SECONDARY_HTTPS_PORT=8444
